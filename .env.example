# ── Databricks ────────────────────────────────────────────────────────────────
# Set automatically by Databricks Apps at runtime.
# Only needed for local development.
DATABRICKS_HOST=https://dbc-db3d8a4e-f2cf.cloud.databricks.com
DATABRICKS_TOKEN=<your-pat-here>         # NEVER commit a real token

# ── Model Serving ─────────────────────────────────────────────────────────────
CLAUDE_ENDPOINT=databricks-claude-opus-5
GPT_ENDPOINT=databricks-gpt-55           # update with actual endpoint name

# ── PHD Catalog (READ ONLY) ───────────────────────────────────────────────────
PHD_CATALOG=rhealth_premier_phd
PHD_SCHEMA=bronze_native_premier_phd

# ── Scratch Catalog (READ/WRITE) ──────────────────────────────────────────────
# All uploads, exports, and generated results go here.
# NOTE: catalog name contains hyphens — must be backtick-quoted in SQL queries.
META_CATALOG=rhealth-catalog-poc
META_SCHEMA=scratch_mtech_ga_dbx_prphd_ads_automation_poc

# ── Volume paths (under the scratch catalog) ───────────────────────────────────
# Protocols uploaded via the UI land in this UC Volume path.
# Create this volume in Databricks if it doesn't exist:
#   CREATE VOLUME IF NOT EXISTS `rhealth-catalog-poc`.scratch_mtech_ga_dbx_prphd_ads_automation_poc.protocols;
PROTOCOL_VOLUME=/Volumes/rhealth-catalog-poc/scratch_mtech_ga_dbx_prphd_ads_automation_poc/protocols
